# Dependencies
node_modules
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Production build
build/
dist/

# Environment variables — NEVER commit these
.env
# WILDCARD FIRST, so a new env file is ignored by DEFAULT rather than by remembering.
# The named list below was exhaustive for the files that existed and silently left every
# later one tracked: on 2026-09-25 a dedicated Anthropic key for a reconciliation run was
# about to go into .env.reconcile.local, which matched nothing here and would have been
# committable. The commit gate would have caught an sk-ant- literal, but the first layer
# should not be the last one.
.env*.local
.env.development
.env.test
.env.staging
.env.production

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# `vercel env pull production` writes a bare file named `production` holding a
# VERCEL_OIDC_TOKEN. It was tracked from 2026-07-27 to 2026-08-21.
production

# MCP config — contains access tokens, never commit
.mcp.json
logs/

# Throwaway test scripts — local only, not for version control
src/lib/composition/test-messaging-run.ts

# Council session artifacts — generated locally, not for version control
council/

# Dogfood seed data — already in DB, no need to track
dogfood-prospects-batch-1.csv
.gstack/
.backups/

# Claude Code tooling artifacts — local state, not for version control.
#
# NOTE THE `/*` RATHER THAN `/`. Git does not descend into an ignored DIRECTORY, so with
# `.claude/` the negations below would never be consulted and the hook scripts would stay
# invisible. Ignoring the CONTENTS instead lets specific paths be re-included.
.claude/*

# ...EXCEPT the parts that are project policy rather than local state.
#
# settings.json holds the shared permission list and the HOOK WIRING. The hook scripts are
# the commit gate: secrets, .env, vendor names, post-edit tsc. A commit gate that is not
# committed protects one laptop and nothing else, which is the same as no gate at all for
# every other machine and for anyone reviewing this repo.
#
# settings.local.json stays ignored on purpose. It accumulates per-machine permission
# grants and is genuinely local state.
!.claude/settings.json
!.claude/hooks/

# Writer re-run exports. Real prospect copy and judge reasoning, produced by
# scripts/export-writer-run.ts for before-and-after comparison. Local measurement
# artifacts, and prospect-identifying content that has no business in the repository.
.writer-export/

# Throwaway analysis harnesses for the 2026-09-21 copy audit. They import @/lib/style/*
# so they must sit at the repo root to resolve, but they are not project code and must not
# ship. Two of them reached a commit via `git add -A` before this line existed.
/faults-lib.ts
/measure.ts
/compare.ts
.scratch/
